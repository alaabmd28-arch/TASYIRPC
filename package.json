{
  "name": "tasyir-bmd-desktop",
  "version": "2.1.0",
  "description": "Tasyir bmd - نسخة الحاسوب",
  "main": "main.js",
  "author": "Tasyir",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": { "electron": ">=33.0.0", "electron-builder": ">=25.1.8" },
  "build": {
    "appId": "com.mycompany.tasyirbmd.desktop",
    "productName": "Tasyir BMD",
    "files": ["main.js", "preload.js", "lib/**", "app/**", "build/icon.png"],
    "win": { "icon": "build/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false },
    "directories": { "output": "dist" }
  }
}
